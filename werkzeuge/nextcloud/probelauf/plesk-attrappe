#!/bin/bash
# plesk-attrappe — bildet im Prüfstand nur nach, was werkzeuge/nextcloud von `plesk` braucht und
# ohne Plesk prüfbar ist: `plesk db` (als MySQL-admin mit /etc/psa/.psa.shadow) und den
# PHP-Handler der Domain. Alles andere (subscription, mail, admin) lehnt sie ab: diese Wege
# bleiben ungeprüft und tragen in den Kopfzeilen `nein`.
H=/etc/plesk-attrappe/handler
adm(){ MYSQL_PWD="$(cat /etc/psa/.psa.shadow)" mysql --no-defaults -u admin "$@"; }
if [ "${1:-}" = db ]; then
  [ $# -eq 1 ] && { adm; exit; }
  case "${3:-}" in *php_handler_id*) cat "$H"; exit 0;; esac
  adm "$2" "$3"; exit
fi
if [ "${1:-} ${2:-} ${3:-}" = "bin domain --update" ]; then
  p=""; for x; do [ "$p" = -php_handler_id ] && echo "$x" > "$H"; p=$x; done; exit 0
fi
echo "plesk-attrappe: nicht nachgebildet: $*" >&2; exit 1
