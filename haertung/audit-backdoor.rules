# ============================================================================
#  audit-backdoor.rules  --  auditd-Regelsatz gegen Backdoors & Persistenz
# ============================================================================
#
#  ZWECK
#  Der Forensik-Scanner liefert nur Momentaufnahmen. auditd protokolliert
#  das VERHALTEN laufend mit - damit sieht man auch Backdoors, die zum
#  Scanzeitpunkt nicht liefen, und man bekommt eine Timeline fuer die
#  Ursachenanalyse.
#
#  INSTALLATION
#     apt install auditd audispd-plugins        # Debian/Ubuntu
#     dnf install audit                          # RHEL/Rocky
#     cp audit-backdoor.rules /etc/audit/rules.d/50-backdoor.rules
#     augenrules --load        # oder: service auditd restart
#     auditctl -l              # geladene Regeln pruefen
#     auditctl -s              # Status, verlorene Events
#
#  AUSWERTUNG (Beispiele)
#     ausearch -k exec_tmp -i --start today
#     ausearch -k ssh_persist -i --start recent
#     ausearch -k memfd -i
#     aureport -k --summary
#     aureport -x --summary --start today     # Executables-Ranking
#
#  WICHTIG - PERFORMANCE
#  Die execve-Regeln (Abschnitt 2) erzeugen auf busy Servern viele Events.
#  Auf stark ausgelasteten Systemen zuerst nur Abschnitte 1, 3 und 4 laden,
#  dann schrittweise erweitern. Buffer und Backlog unten sind entsprechend
#  hoch gesetzt. Mit "auditctl -s" pruefen, ob "lost" > 0 ist; falls ja,
#  -b weiter erhoehen oder Regeln reduzieren.
#
#  HINWEIS ZUR MANIPULATIONSSICHERHEIT
#  Zeile "-e 2" am Ende macht die Regeln bis zum Reboot unveraenderlich.
#  Das ist gut gegen Angreifer, aber man kann Regeln dann nur noch nach
#  einem Neustart aendern. Beim Einfuehren erst mit "-e 1" testen.
# ============================================================================

## ---------------------------------------------------------------------------
## 0) Grundkonfiguration
## ---------------------------------------------------------------------------

# Alte Regeln loeschen
-D

# Buffer (Default 8192 ist fuer execve-Logging zu klein)
-b 32768

# Backlog-Wartezeit in ms; 0 = nicht blockieren wenn Puffer voll
--backlog_wait_time 60000

# Verhalten bei Fehlern: 1 = printk (Meldung ins Kernel-Log), 2 = panic
-f 1

# Eigenes Rauschen ausblenden: auditd-Prozesse selbst nicht protokollieren
-a never,exit -F arch=b64 -S all -F exe=/usr/sbin/auditd
-a never,user -F subj_type=crond_t
-a never,exit -F subj_type=crond_t


## ---------------------------------------------------------------------------
## 1) AUSFUEHRUNG AUS FLUECHTIGEN VERZEICHNISSEN
##    Kein legitimer Dienst startet Binaries aus /tmp, /dev/shm oder /var/tmp.
##    Dies ist das Signal mit dem besten Verhaeltnis von Treffern zu Rauschen.
## ---------------------------------------------------------------------------

-a always,exit -F arch=b64 -F dir=/tmp     -F perm=x -F key=exec_tmp
-a always,exit -F arch=b32 -F dir=/tmp     -F perm=x -F key=exec_tmp
-a always,exit -F arch=b64 -F dir=/var/tmp -F perm=x -F key=exec_tmp
-a always,exit -F arch=b32 -F dir=/var/tmp -F perm=x -F key=exec_tmp
-a always,exit -F arch=b64 -F dir=/dev/shm -F perm=x -F key=exec_tmp
-a always,exit -F arch=b32 -F dir=/dev/shm -F perm=x -F key=exec_tmp

# Ausfuehrung aus Webroots - eine PHP-Datei darf nie ein Binary starten,
# das aus dem Webroot selbst kommt.
-a always,exit -F arch=b64 -F dir=/var/www -F perm=x -F key=exec_webroot
-a always,exit -F arch=b32 -F dir=/var/www -F perm=x -F key=exec_webroot

# Ausfuehrung aus User-Cache-Verzeichnissen (beliebtes Versteck)
-a always,exit -F arch=b64 -F dir=/root/.cache -F perm=x -F key=exec_cache


## ---------------------------------------------------------------------------
## 2) FILELESS EXECUTION  (memfd_create -> Binary lebt nur im RAM)
##    Genau das Muster, das kein Datei-Scanner findet.
## ---------------------------------------------------------------------------

-a always,exit -F arch=b64 -S memfd_create -F key=memfd
-a always,exit -F arch=b32 -S memfd_create -F key=memfd

# fexecve/execveat auf einen anonymen Filedeskriptor
-a always,exit -F arch=b64 -S execveat -F key=memfd
-a always,exit -F arch=b32 -S execveat -F key=memfd


## ---------------------------------------------------------------------------
## 3) PERSISTENZ-DATEIEN
##    Schreibzugriffe auf alles, worueber sich ein Angreifer festsetzt.
## ---------------------------------------------------------------------------

# --- Cron ---
-w /etc/crontab           -p wa -k cron_persist
-w /etc/cron.d/           -p wa -k cron_persist
-w /etc/cron.hourly/      -p wa -k cron_persist
-w /etc/cron.daily/       -p wa -k cron_persist
-w /etc/cron.weekly/      -p wa -k cron_persist
-w /etc/cron.monthly/     -p wa -k cron_persist
-w /etc/anacrontab        -p wa -k cron_persist
-w /var/spool/cron/       -p wa -k cron_persist
-w /var/spool/at/         -p wa -k cron_persist
-w /etc/at.allow          -p wa -k cron_persist
-w /etc/at.deny           -p wa -k cron_persist

# --- systemd ---
-w /etc/systemd/system/       -p wa -k systemd_persist
-w /lib/systemd/system/       -p wa -k systemd_persist
-w /usr/lib/systemd/system/   -p wa -k systemd_persist
-w /etc/systemd/user/         -p wa -k systemd_persist
-w /var/lib/systemd/linger/   -p wa -k systemd_persist

# --- SSH  (dein konkreter Fund lag in .ssh/) ---
-w /etc/ssh/sshd_config   -p wa -k ssh_persist
-w /etc/ssh/sshrc         -p wa -k ssh_persist
-w /root/.ssh/            -p wa -k ssh_persist
# Fuer weitere User analog ergaenzen, z.B.:
# -w /home/deploy/.ssh/   -p wa -k ssh_persist
# -w /home/www-data/.ssh/ -p wa -k ssh_persist

# --- Shell-Profile & Autostart ---
-w /etc/profile           -p wa -k shell_persist
-w /etc/profile.d/        -p wa -k shell_persist
-w /etc/bash.bashrc       -p wa -k shell_persist
-w /etc/rc.local          -p wa -k shell_persist
-w /etc/update-motd.d/    -p wa -k shell_persist
-w /root/.bashrc          -p wa -k shell_persist
-w /root/.bash_profile    -p wa -k shell_persist
-w /root/.profile         -p wa -k shell_persist

# --- Rootkit-Hooks ---
-w /etc/ld.so.preload     -p wa -k rootkit_hook
-w /etc/ld.so.conf        -p wa -k rootkit_hook
-w /etc/ld.so.conf.d/     -p wa -k rootkit_hook

# --- udev / PAM / APT-Hooks ---
-w /etc/udev/rules.d/     -p wa -k hook_persist
-w /etc/pam.d/            -p wa -k hook_persist
-w /etc/apt/apt.conf.d/   -p wa -k hook_persist

# --- Accounts ---
-w /etc/passwd            -p wa -k account_change
-w /etc/shadow            -p wa -k account_change
-w /etc/group             -p wa -k account_change
-w /etc/gshadow           -p wa -k account_change
-w /etc/sudoers           -p wa -k account_change
-w /etc/sudoers.d/        -p wa -k account_change


## ---------------------------------------------------------------------------
## 4) KERNEL-MODULE  (LKM-Rootkits)
## ---------------------------------------------------------------------------

-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F key=kernel_module
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F key=kernel_module
-w /sbin/insmod   -p x -k kernel_module
-w /sbin/rmmod    -p x -k kernel_module
-w /sbin/modprobe -p x -k kernel_module


## ---------------------------------------------------------------------------
## 5) VERDAECHTIGE WERKZEUGE
##    Nicht per se boese - aber die Nutzung sollte erklaerbar sein.
## ---------------------------------------------------------------------------

-w /usr/bin/nc              -p x -k netcat_use
-w /bin/nc                  -p x -k netcat_use
-w /usr/bin/ncat            -p x -k netcat_use
-w /usr/bin/netcat          -p x -k netcat_use
-w /usr/bin/nc.traditional  -p x -k netcat_use
-w /usr/bin/nc.openbsd      -p x -k netcat_use
-w /usr/bin/socat           -p x -k netcat_use

# Compiler auf Produktionsservern - typisch fuer lokale Privilege Escalation
-w /usr/bin/gcc             -p x -k compiler_use
-w /usr/bin/cc              -p x -k compiler_use
-w /usr/bin/make            -p x -k compiler_use

# Downloader
-w /usr/bin/curl            -p x -k downloader_use
-w /usr/bin/wget            -p x -k downloader_use

# Spurenbeseitigung
-w /usr/bin/shred           -p x -k antiforensic
-w /usr/bin/wipe            -p x -k antiforensic
-w /var/log/                -p wa -k log_tamper
-w /var/log/wtmp            -p wa -k log_tamper
-w /var/log/btmp            -p wa -k log_tamper
-w /var/log/lastlog         -p wa -k log_tamper

# Manipulation von Datei-Zeitstempeln (Timestomping)
-a always,exit -F arch=b64 -S utimensat,futimesat -F key=timestomp


## ---------------------------------------------------------------------------
## 6) PRIVILEGIEN-ESKALATION
## ---------------------------------------------------------------------------

# setuid/setgid-Aufrufe durch nicht-root
-a always,exit -F arch=b64 -S setuid,setreuid,setresuid -F auid>=1000 -F auid!=unset -F key=privesc
-a always,exit -F arch=b64 -S setgid,setregid,setresgid -F auid>=1000 -F auid!=unset -F key=privesc

# Setzen von SUID-Bits
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -F key=perm_change

# ptrace - Prozess-Injection
-a always,exit -F arch=b64 -S ptrace -F key=ptrace_use
-a always,exit -F arch=b32 -S ptrace -F key=ptrace_use


## ---------------------------------------------------------------------------
## 7) EXECVE-VOLLPROTOKOLLIERUNG  (OPTIONAL - hohes Volumen!)
##    Auskommentiert lassen, bis Abschnitte 1-6 stabil laufen.
##    Liefert die vollstaendige Kommando-Timeline - Gold wert bei einem
##    Vorfall, aber teuer im Betrieb.
## ---------------------------------------------------------------------------

# Alle Kommandos von normalen Usern:
#-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=unset -F key=exec_user
#-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=unset -F key=exec_user

# Alle Kommandos, die als root laufen aber von einem User initiiert wurden
# (also ueber sudo/su - das ist meist die interessantere Teilmenge):
#-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -F key=exec_root

# Kommandos des Webserver-Users -- sehr aussagekraeftig bei WordPress-Fleets:
# jede Shell, die www-data startet, ist erklaerungsbeduerftig.
-a always,exit -F arch=b64 -S execve -F uid=www-data -F key=exec_webuser
-a always,exit -F arch=b32 -S execve -F uid=www-data -F key=exec_webuser


## ---------------------------------------------------------------------------
## 8) AUSGEHENDE VERBINDUNGEN  (OPTIONAL - sehr hohes Volumen)
##    gsocket faellt nur ueber ausgehende Verbindungen auf. Wenn du das
##    Volumen tragen kannst, ist das die direkteste Erkennung.
## ---------------------------------------------------------------------------

#-a always,exit -F arch=b64 -S connect -F key=net_connect
#-a always,exit -F arch=b32 -S connect -F key=net_connect

# Sparsamer: nur Verbindungen des Webserver-Users protokollieren
-a always,exit -F arch=b64 -S connect -F uid=www-data -F key=net_webuser


## ---------------------------------------------------------------------------
## 9) REGELN SPERREN
##    Ab hier sind die Regeln bis zum naechsten Reboot unveraenderlich.
##    Beim Einfuehren erst auskommentiert lassen bzw. "-e 1" verwenden.
## ---------------------------------------------------------------------------

#-e 2
